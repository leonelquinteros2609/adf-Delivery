{
	"name": "df_promociones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "promociones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          porcentaje_descuento as string,",
				"          canal_aplicable as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 split(!isNull(canal_aplicable) && trim(canal_aplicable) != '',",
				"     disjoint: false) ~> split1@(valido, rechazado)",
				"split1@valido derive(fecha_inicio = toTimestamp(fecha_inicio, 'yyyy-MM-dd'),",
				"          fecha_fin = toTimestamp(fecha_fin, 'yyyy-MM-dd'),",
				"          porcentaje_descuento = toInteger(porcentaje_descuento)) ~> derivedColumn1"
			]
		}
	}
}